---
import { Image } from 'astro:assets';
import villa from '../assets/villa-footer.jpeg';
import instagram from '../assets/icons/social-media/instagram.svg?raw';
import facebook from '../assets/icons/social-media/facebook.svg?raw';
import linkedin from '../assets/icons/social-media/linkedin.svg?raw';

const base = Astro.url.pathname === '/' ? '' : '/';

const columns = [
	[
		{ label: 'Home', href: `${base}#top` },
		{ label: 'About Us', href: `${base}#about` },
		{ label: 'Featured', href: `${base}#properties` },
		{ label: 'Listings', href: '/offers' },
	],
	[
		{ label: 'Our Team', href: `${base}#agents` },
		{ label: 'Market', href: `${base}#about` },
		{ label: 'Insights', href: `${base}#about` },
		{ label: 'Contact Us', href: `${base}#contact` },
	],
];

const socials = [
	{ label: 'Instagram', href: '#', icon: instagram },
	{ label: 'Facebook', href: '#', icon: facebook },
	{ label: 'LinkedIn', href: '#', icon: linkedin },
];

const year = new Date().getFullYear();
---

<footer id="contact" class="on-dark bg-abyss text-paper relative isolate overflow-hidden px-5 pt-20 pb-8 md:px-10 lg:px-16 lg:pt-28">
	<Image
		src={villa}
		alt=""
		widths={[640, 808]}
		sizes="100vw"
		loading="lazy"
		aria-hidden="true"
		class="pointer-events-none absolute inset-0 -z-20 h-full w-full object-cover object-center"
	/>
	<div aria-hidden="true" class="bg-abyss/55 pointer-events-none absolute inset-0 -z-10"></div>
	<div
		aria-hidden="true"
		class="from-abyss via-abyss/40 to-abyss/90 pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b"
	>
	</div>

	<div class="relative mx-auto max-w-7xl">
		<div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.4fr] lg:gap-10">
			<div>
				<a href={`${base}#top`} class="text-2xl font-semibold tracking-[0.18em]">VPG</a>
				<p class="text-paper/80 mt-4 max-w-xs text-sm leading-relaxed">
					A full-service real estate brokerage specializing in residential, commercial, and luxury property
					investments.
				</p>
				<ul class="mt-6 flex items-center gap-3">
					{
						socials.map((s) => (
							<li>
								<a
									href={s.href}
									aria-label={s.label}
									class="border-paper/30 hover:bg-paper/15 hover:border-paper/60 grid size-10 place-items-center rounded-full border transition-colors [&>svg]:size-4"
									set:html={s.icon}
								/>
							</li>
						))
					}
				</ul>
			</div>

			{
				columns.map((col, i) => (
					<nav aria-label={i === 0 ? 'Footer' : 'Footer secondary'}>
						<h3 class="text-paper/60 mb-4 text-xs font-semibold tracking-[0.2em] uppercase">
							{i === 0 ? 'Explore' : 'Company'}
						</h3>
						<ul class="flex flex-col gap-3 text-sm">
							{col.map((l) => (
								<li>
									<a href={l.href} class="text-paper/90 hover:text-paper transition-colors hover:underline hover:underline-offset-4">
										{l.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}

			<address class="not-italic">
				<h3 class="text-paper/60 mb-4 text-xs font-semibold tracking-[0.2em] uppercase">Contact</h3>
				<ul class="text-paper/90 flex flex-col gap-3 text-sm">
					<li>100 Main Street, Suite 400, Metropolitan City</li>
					<li><a href="tel:+15552345678" class="hover:underline hover:underline-offset-4">+1 (555) 234-5678</a></li>
					<li><a href="mailto:contact@apexrealestate.com" class="hover:underline hover:underline-offset-4">contact@apexrealestate.com</a></li>
					<li class="text-paper/70">Mon – Fri: 9:00 AM – 6:00 PM<br />Sat: 10:00 AM – 2:00 PM</li>
				</ul>
			</address>
		</div>

		<div class="text-paper/70 mt-16 flex flex-col items-center justify-between gap-3 text-xs md:flex-row">
			<p>© {year} Apex Real Estate Inc. All rights reserved.</p>
			<p class="flex gap-5">
				<a href="#" class="hover:text-paper transition-colors">Privacy Policy</a>
				<a href="#" class="hover:text-paper transition-colors">Terms of Service</a>
				<a href="#" class="hover:text-paper transition-colors">Cookie Settings</a>
			</p>
		</div>
	</div>
</footer>
